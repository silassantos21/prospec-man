# ProspecMan — Configuração de Ambiente
# Copie este arquivo para .env e preencha as chaves

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Groq (Whisper gratuito) — https://console.groq.com/
GROQ_API_KEY=gsk_...

# Configurações opcionais
DEFAULT_OUTPUT_DIR=./projects
DEFAULT_LANGUAGE=pt
USD_TO_BRL_RATE=5.70
VSCODE_COMMAND=code

# E-mail (opcional) — para enviar o projeto ZIP ao usuário
# Use uma Senha de App do Google: myaccount.google.com/apppasswords
EMAIL_USER=seu@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
